# STT 引擎:sensevoice(默认,中文秒出,中英日韩粤)/ mlx-whisper(英文/小语种更强,fallback)
STT_ENGINE=sensevoice

# Local Whisper (STT) — 仅 STT_ENGINE=mlx-whisper 时生效
# Options: tiny(75MB), base(145MB), small(488MB), medium(1.5GB), large-v3(3GB)
WHISPER_MODEL=large-v3

# Audio & Server
SAMPLE_RATE=16000
LANGUAGE=zh
# SERVER_PORT=9876

# 反馈音效 (System/Library/Sounds/<name>.aiff)
# 觉得默认音太长(Blow 1.4s / Glass 1.65s)可换短音: Tink, Pop, Submarine, Frog ...
# SOUND_ENABLED=false 可完全关闭
SOUND_ENABLED=true
START_SOUND=Blow
DONE_SOUND=Glass

# STT 误识词纠正(转写后、输出前)
# 词表文件默认在项目根 corrections.json,日常发现新误识 → 编辑该文件加一行 → 重启服务生效。
# key = STT 常输出的误识形式(匹配时大小写不敏感),value = 正确写法(保留原样大小写输出)。
# 纯整词匹配,不会误伤子串(如 'scu' 不会改 'sculpture');多 token 短语也支持(如 'claude code' → 'Claude Code')。
# CORRECTIONS_ENABLED=false 可临时关闭此功能(词表仍加载但不应用)。
# CORRECTIONS_FILE=/path/to/your.json 可指向自定义词表(空 = 用项目内默认)。
CORRECTIONS_ENABLED=true
# CORRECTIONS_FILE=
